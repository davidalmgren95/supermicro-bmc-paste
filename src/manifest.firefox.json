{
  "manifest_version": 2,
  "name": "supermicro-bmc-paste",
  "version": "1.0.0",
  "description": "Easily paste text into Supermicro BMC HTML5 virtual consoles.",
  "permissions": [
    "contextMenus",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "supermicro-bmc-paste@example.com"
    }
  }
}
