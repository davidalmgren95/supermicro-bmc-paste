{
  "manifest_version": 3,
  "name": "supermicro-bmc-paste",
  "version": "1.0.0",
  "description": "Easily paste text into Supermicro BMC HTML5 virtual consoles.",
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
